# Cadena de conexion de Neon, en una sola linea y sin comillas. La del pooler
# (el host lleva «-pooler») aguanta muchas mas conexiones.
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# La misma clave en todos los servicios: con la que firma user-management se
# comprueban las sesiones en los demas.
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Inicio de sesion con Google.
GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_SERVER_CLIENT_ID=TU_SERVER_CLIENT_ID.apps.googleusercontent.com

# Codigos de invitacion para registrarse como docente o director. Sin ellos
# esos registros quedan cerrados y solo se pueden crear estudiantes. Pon uno
# largo y daselo solo a quien corresponda.
DOCENTE_SIGNUP_CODE=
DIRECTOR_SIGNUP_CODE=

# Otras paginas, ademas de la web publicada y localhost, que pueden llamar al
# API desde el navegador (separadas por comas). Normalmente vacio.
CORS_ORIGINS=

# Solo en local: acepta tokens "dev:correo" en el login con Google para
# probar sin cuenta de Google. NUNCA en Render.
# ALLOW_DEV_LOGIN=1
